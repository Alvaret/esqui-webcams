{
	"version": 3,
	"routes": [
		{
			"handle": "filesystem"
		},
		{
			"src": "^/_astro/(.*)$",
			"headers": {
				"cache-control": "public, max-age=31536000, immutable"
			},
			"continue": true
		},
		{
			"src": "^/_server-islands/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/_image/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/estacion-db/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/estaciones/?$",
			"dest": "_render"
		},
		{
			"src": "^/api/estaciones-db/?$",
			"dest": "_render"
		},
		{
			"src": "^/estacion/([^/]+?)/?$",
			"dest": "_render"
		},
		{
			"src": "^/load-data/?$",
			"dest": "_render"
		},
		{
			"src": "^/prueba/?$",
			"dest": "_render"
		},
		{
			"src": "^/supabase-test/?$",
			"dest": "_render"
		},
		{
			"src": "^/$",
			"dest": "_render"
		}
	]
}