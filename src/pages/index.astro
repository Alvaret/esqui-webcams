---
import opciones from '../data/opciones.json';
import OpcionCard from '../components/OpcionCard/OpcionCard.astro';
import FloatingCredit from '../components/FloatingCredit/FloatingCredit.astro';
import { obtenerTiempoEstaciones } from '../lib/weather';

const estaciones = Object.entries(opciones);

// Tiempo a 14 días para marcar las estaciones con nevadas previstas
let tiempoEstaciones: Record<string, import('../lib/weather').TiempoEstacion> = {};
try {
	tiempoEstaciones = await obtenerTiempoEstaciones();
} catch (error) {
	console.error('Error al obtener el tiempo para la home:', error);
}
---

<html lang="es">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<title>PLWinterCam | Cámaras de montaña en directo</title>
		<meta name="description" content="Cámaras de esquí en directo en estaciones de los Pirineos." />
		<meta name="theme-color" content="#15130f" />
		<meta name="mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-capable" content="yes" />
		<meta name="apple-mobile-web-app-title" content="PLWinterCam" />
		<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
		<link rel="manifest" href="/manifest.webmanifest" />
		<link rel="apple-touch-icon" sizes="180x180" href="/icons/plwintercam-180.png" />
		<style is:global>
			@import '../styles/index.css';
		</style>
	</head>
	<body class="page-home">
		<header class="site-header">
			<div class="site-header-inner">
				<a class="brand" href="/" aria-label="PLWinterCam, inicio">
					<span class="brand-mark" aria-hidden="true">P</span>
					<span class="brand-name">PLWinterCam</span>
				</a>
				<a class="header-status" href="/load-data"><span class="signal-dot"></span>EN DIRECTO</a>
			</div>
		</header>

		<main class="container">
			<section class="directory-intro" aria-labelledby="page-title">
				<h1 id="page-title">La montaña, <span class="now">ahora.</span></h1>
				<p class="intro-copy">Consulta las condiciones y el ambiente en las estaciones en tiempo real.</p>
				<div class="condition-chips" aria-hidden="true">
					<span class="condition-chip chip-live"><span class="chip-swatch"></span>EN DIRECTO</span>
					<span class="condition-chip"><span class="chip-swatch" style="background: var(--amber)"></span>SIN CÁMARA</span>
				</div>
			</section>

			<section class="station-directory" aria-label="Estaciones de esquí">
				<div class="directory-toolbar">
					<label class="search-field">
						<span class="search-icon" aria-hidden="true"></span>
						<span class="visually-hidden">Buscar estación</span>
						<input id="station-search" type="search" placeholder="Buscar estación" autocomplete="off" />
					</label>
					<p id="station-count" class="station-count" aria-live="polite">{estaciones.length} ESTACIONES</p>
				</div>

				<div class="opciones-grid" id="station-grid">
				{
					estaciones.map(([clave, opcion], index) => (
						<OpcionCard
							clave={clave}
							nombre={opcion.nombre}
							urlFoto={opcion.urlFoto}
							indice={index + 1}
							webcams={opcion.webcams?.length ?? 0}
							altitudMinima={opcion.altitudMinima}
							altitudMaxima={opcion.altitudMaxima}
							nevadaCm={tiempoEstaciones[clave]?.nevadaTotalCm}
							primerDiaNevada={tiempoEstaciones[clave]?.primerDiaNevada}
						/>
					))
				}
			</div>
				<p id="no-stations" class="no-stations" hidden>No hay estaciones con ese nombre.</p>
			</section>
		</main>

		<FloatingCredit />

		<script>
			import '../scripts/register-sw';

			const searchInput = document.querySelector<HTMLInputElement>('#station-search');
			const stationCards = [...document.querySelectorAll<HTMLAnchorElement>('[data-station-card]')];
			const stationCount = document.querySelector<HTMLElement>('#station-count');
			const noStations = document.querySelector<HTMLElement>('#no-stations');

			searchInput?.addEventListener('input', (event: Event) => {
				const input = event.currentTarget as HTMLInputElement;
				const query = input.value.normalize('NFD').replace(/[\u0300-\u036f]/g, '').trim().toLowerCase();
				let visibleCount = 0;

				stationCards.forEach((card) => {
					const matches = (card.dataset.name ?? '').includes(query);
					card.hidden = !matches;
					if (matches) visibleCount += 1;
				});

				if (stationCount) stationCount.textContent = `${visibleCount} ${visibleCount === 1 ? 'ESTACIÓN' : 'ESTACIONES'}`;
				if (noStations) noStations.hidden = visibleCount !== 0;
			});
		</script>
	</body>
</html>
