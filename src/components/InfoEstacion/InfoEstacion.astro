---
import type { EstacionData } from '../../lib/api';

interface Props {
  data: EstacionData;
}

const { data } = Astro.props;

// Formatear los datos para mostrar
const remontes = data.remontes_abiertos && data.remontes_totales 
  ? `${data.remontes_abiertos}/${data.remontes_totales}`
  : 'No disponible';

const kilometros = data.kilometros_abiertos && data.kilometros_totales
  ? `${data.kilometros_abiertos}/${data.kilometros_totales} km`
  : 'No disponible';

const nieve = data.nieve || 'No disponible';
const valorNumerico = (valor?: string) => {
  if (valor == null || valor.trim() === '') return null;
  const numero = Number(valor.trim().replace(',', '.'));
  return Number.isFinite(numero) ? numero : null;
};
const estacionCerrada = valorNumerico(data.remontes_abiertos) === 0
  && valorNumerico(data.kilometros_abiertos) === 0;

// Formatear la fecha de actualización
const fechaActualizacion = data.timestamp 
  ? new Date(data.timestamp).toLocaleString('es-ES', {
      day: '2-digit',
      month: '2-digit',
      year: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  : null;
---

<div class="datos">
  {estacionCerrada && (
    <div class="closed-status" role="status">
      <span class="closed-status-mark" aria-hidden="true">!</span>
      <div>
        <strong>Estación cerrada</strong>
        <p>No hay remontes ni kilómetros de pistas abiertos en este momento.</p>
      </div>
    </div>
  )}

  {fechaActualizacion && (
    <div class="timestamp-header">
      <span class="icono-reloj">🕐</span>
      <span>Última actualización: {fechaActualizacion}</span>
    </div>
  )}

  <div class="dato-card">
    <div class="icono">🚡</div>
    <div class="contenido">
      <span class="label">Remontes</span>
      <span class="valor">{remontes}</span>
    </div>
  </div>

  <div class="dato-card">
    <div class="icono">⛷️</div>
    <div class="contenido">
      <span class="label">Kilómetros</span>
      <span class="valor">{kilometros}</span>
    </div>
  </div>

  <div class="dato-card">
    <div class="icono">❄️</div>
    <div class="contenido">
      <span class="label">Nieve</span>
      <span class="valor">{nieve}</span>
    </div>
  </div>
</div>

<style>
  .datos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    width: 100%;
    border-top: 1px solid var(--line);
  }

  .timestamp-header {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 10px;
    font-weight: 600;
  }

  .closed-status {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 12px;
    border-left: 3px solid var(--coral);
    background: #f5e7df;
  }

  .closed-status-mark {
    display: grid;
    width: 23px;
    height: 23px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: var(--coral);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
  }

  .closed-status strong {
    color: var(--ink);
    font-size: 12px;
  }

  .closed-status p {
    margin: 2px 0 0;
    color: var(--muted);
    font-size: 10px;
    line-height: 1.4;
  }

  .icono-reloj {
    color: var(--coral);
    font-size: 13px;
  }

  .dato-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 4px;
    padding: 11px 7px 11px 0;
    border-right: 1px solid var(--line);
  }

  .dato-card:last-child {
    border-right: 0;
  }

  .icono {
    font-size: 14px;
    line-height: 1;
    flex-shrink: 0;
  }

  .contenido {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .label {
    color: var(--muted);
    font-size: 9px;
    font-weight: 700;
  }

  .valor {
    color: var(--ink);
    font-family: var(--display);
    font-size: 19px;
    font-weight: 600;
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .error-message {
    padding: 12px;
    width: 100%;
    border-left: 3px solid var(--coral);
    background: var(--paper-deep);
  }

  .error-message p {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    font-size: 12px;
  }

  @media (min-width: 680px) {
    .datos {
      max-width: 680px;
    }

    .icono {
      font-size: 16px;
    }

    .valor {
      font-size: 23px;
    }
  }
</style>
